# Copy this file to .env.local and fill in your own key.
# .env.local is gitignored — it will never be committed.

# Free key from https://pro.coinmarketcap.com/signup (Basic plan: 15,000 credits/month, no card required)
CMC_API_KEY=your-coinmarketcap-api-key-here

# Optional — only needed for deployment (see README "Deploying" section).
# Local `npm run dev` works fine without these; the portfolio just falls
# back to a local JSON file instead of Redis.
# Auto-filled if you add the Upstash integration from the Vercel dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
